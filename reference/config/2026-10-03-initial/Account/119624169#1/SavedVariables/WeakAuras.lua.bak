["custom_type"] = "status",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["unit"] = "player",
["event"] = "Health",
["customStacks"] = "",
["customDuration"] = "function() \n    return aura_env.wc_count, 2, true\nend",
["spellIds"] = {
},
["events"] = "UNIT_SPELLCAST_SUCCEEDED:player,PLAYER_TARGET_CHANGED,UNIT_AURA:target",
["custom"] = "function(event, arg1, arg2, arg3)\n    if (event == \"PLAYER_TARGET_CHANGED\") then\n        aura_env.wc_count = 0\n        local name, _, count = WA_GetUnitDebuff(\"target\", 228358, \"PLAYER\") -- Winter's Chill\n        if (name ~= nil) then\n            aura_env.wc_count = count\n        end\n    end\n    \n    if (event == \"UNIT_AURA\") then\n        local hasWC = false\n        local name = WA_GetUnitDebuff(\"target\", 228358, \"PLAYER\") -- Winter's Chill\n        if (name ~= nil) then\n            hasWC = true\n        end\n        if (hasWC == false) and (time() - aura_env.flurry_time > 2) then\n            aura_env.wc_count = 0\n        end\n    end\n    \n    if (event == \"UNIT_SPELLCAST_SUCCEEDED\") then\n        local id = arg3\n        local fof = C_UnitAuras.GetPlayerAuraBySpellID(44544) or 0\n        \n        if (id == 44614) then -- Flurry\n            aura_env.wc_count = 2 \n            aura_env.flurry_time = time()\n        end\n        if (id == 30455) and fof == 0 then -- Ice Lance and not Finger of Frost\n            if (aura_env.wc_count > 0) then\n                aura_env.wc_count = aura_env.wc_count - 1\n            end\n        end\n        if (id == 116) or (id == 199786) or (id == 431044) or (id == 120) then -- Frostbolt / Glacial Spike / Frostfire Bolt / Cone of Cold\n            if (aura_env.wc_count > 0) then\n                aura_env.wc_count = aura_env.wc_count - 1\n            end\n        end\n    end\n    \n    return true\nend",
