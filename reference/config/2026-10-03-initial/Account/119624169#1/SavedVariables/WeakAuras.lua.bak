{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED:SPELL_AURA_REMOVED_DOSE",
["custom"] = "function(allstates, e, _, subEvent, _, sourceGUID, _, _, _, _, _, _, _, spellID)\n    if spellID == 55342 and sourceGUID == UnitGUID(\"player\") then\n        if subEvent == \"SPELL_AURA_APPLIED\" then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                stacks = 3,\n                duration = 40,\n                expirationTime = GetTime() + 40,\n                autoHide = true,\n                progressType = \"timed\",\n                icon = C_Spell.GetSpellTexture(55342),\n                name = C_Spell.GetSpellName(55342),\n            }\n            return true\n        elseif subEvent == \"SPELL_AURA_REMOVED\" and allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        elseif subEvent == \"SPELL_AURA_REMOVED_DOSE\" and allstates[\"\"] then\n            allstates[\"\"].stacks = allstates[\"\"].stacks - 1\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
