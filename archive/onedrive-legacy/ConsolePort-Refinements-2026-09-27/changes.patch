+local ForeverBaseBindings = { PAD1 = 'JUMP'; PAD2 = ''; PAD3 = 'INTERACTTARGET'; PAD4 = 'TURNORACTION' };
+local function UpdateForeverBaseIcon(self)
+	if self:GetParent().id ~= 'Base' or self._state_type ~= 'custom' then return end;
+	if GetBindingAction(self.id) ~= ForeverBaseBindings[self.id] then return end;
+	local icon = self.icon;
+	if self.id == 'PAD1' then
+		-- gamepad-ability-icon-jump; original sheet, exact DB2 member coordinates.
+		icon:SetTexture([[Interface\AddOns\ConsolePort_Forever\Assets\ForeverInGame.blp]])
+		icon:SetTexCoord(397/2048, 461/2048, 1682/2048, 1746/2048)
+	elseif self.id == 'PAD2' then
+		icon:SetAtlas('128-redbutton-exit')
+	elseif self.id == 'PAD3' then
+		-- Forever's default interact/attack symbol, not a change to the binding.
+		icon:SetTexture(C_Spell.GetSpellTexture(6603))
+	elseif self.id == 'PAD4' then
+		icon:SetAtlas(UnitExists('target') and 'crosshair_inspect_32' or 'crosshair_unableinspect_32')
+	end
+	icon:Show()
+end
 
